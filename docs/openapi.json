 "components": {
  "schemas": {
   "CompleteIn": {
    "properties": {
     "failure_mode_found": {
      "type": "string",
      "pattern": "^(outer_race|imbalance|misalignment|lubrication|none)$",
      "title": "Failure Mode Found"
     },
     "notes": {
      "type": "string",
      "maxLength": 1000,
      "minLength": 5,
      "title": "Notes"
     }
    },
    "type": "object",
    "required": [
     "failure_mode_found",
     "notes"
    ],
    "title": "CompleteIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "PlanIn": {
    "properties": {
     "horizon_days": {
      "type": "integer",
      "maximum": 30.0,
      "minimum": 3.0,
      "title": "Horizon Days",
      "default": 14
     }
    },
    "type": "object",
    "title": "PlanIn"
   },
   "RunIn": {
    "properties": {
     "hours": {
      "type": "integer",
      "maximum": 720.0,
      "minimum": 6.0,
      "title": "Hours"
     }
    },
    "type": "object",
    "required": [
     "hours"
    ],
    "title": "RunIn"
   },
   "SignalsIn": {
    "properties": {
     "sensor_id": {
      "type": "string",
      "format": "uuid",
      "title": "Sensor Id"
     },
     "windows": {
      "items": {
       "$ref": "#/components/schemas/Window"
      },
      "type": "array",
      "maxItems": 20,
      "minItems": 1,
      "title": "Windows"
     }
    },
    "type": "object",
    "required": [
     "sensor_id",
     "windows"
    ],
    "title": "SignalsIn"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   },
   "Window": {
    "properties": {
     "started_at": {
      "type": "string",
      "format": "date-time",
      "title": "Started At"
     },
     "shaft_hz": {
      "type": "number",
      "exclusiveMaximum": 200.0,
      "exclusiveMinimum": 1.0,
      "title": "Shaft Hz"
     },
     "samples_base64": {
      "type": "string",
      "title": "Samples Base64",
      "description": "4096 little-endian float32 acceleration samples at 8192 Hz"
     }
    },
    "type": "object",
    "required": [
     "started_at",
     "shaft_hz",
     "samples_base64"
    ],
    "title": "Window"
   },
   "WorkOrderIn": {
    "properties": {
     "asset_id": {
      "type": "string",
      "format": "uuid",
      "title": "Asset Id"
     },
     "work_type": {
      "type": "string",
      "pattern": "^(bearing_replacement|balancing|alignment|lubrication|inspection)$",
      "title": "Work Type"
     },
     "maintenance_window_id": {
      "anyOf": [
       {
        "type": "string",
        "format": "uuid"
       },
       {
        "type": "null"
       }
      ],
      "title": "Maintenance Window Id"
     }
    },
    "type": "object",
    "required": [
     "asset_id",
     "work_type"
    ],
    "title": "WorkOrderIn"
   }
  }
 }
}